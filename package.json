{
  "name": "volt",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-Friction Impact & Mathematical Weightage Engine",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "bun test",
    "db:generate": "bun --filter @volt/db db:generate",
    "db:migrate": "bun --filter @volt/db db:migrate",
    "db:seed": "bun --filter @volt/db db:seed",
    "infra:setup": "bun --filter @volt/cli infra:setup",
    "quality:gate": "bun run scripts/quality-gate.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20.0.0"
  }
}
