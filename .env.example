# ============================================================================
# 1. CORE SERVER & ENVIRONMENT
# ============================================================================
NODE_ENV="development"
PORT="8080"
API_PUBLIC_URL="http://localhost:8080"
WEB_PUBLIC_URL="http://localhost:3000"
CANONICAL_TIMEZONE="Asia/Kolkata"

# ============================================================================
# 2. NEON POSTGRES + FIREBASE AUTH (GOOGLE CLOUD IDENTITY PLATFORM)
# ============================================================================
DATABASE_URL="postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/volt?sslmode=require"
# API: Firebase ID tokens are verified against this project (no secret needed;
# Google's public signing keys are fetched by firebase-admin).
FIREBASE_PROJECT_ID="your-gcp-project-id"
# Web: public Firebase web app config (Project settings > Your apps > Web app).
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-gcp-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-gcp-project-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000"

# ============================================================================
# 3. UPSTASH REDIS (SERVERLESS STAGING BUFFER & PBAC CACHE)
# ============================================================================
UPSTASH_REDIS_REST_URL="https://example-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AX-example-upstash-token"

# ============================================================================
# 4. GEMINI 1.5 FLASH (AI JUDGE & MULTIMODAL AUDIO STT)
# ============================================================================
GEMINI_API_KEY="AIzaSyExampleGeminiKey"
GEMINI_MODEL_ID="gemini-1.5-flash"

# ============================================================================
# 5. GITHUB APP INTEGRATION ("CONNECT GITHUB" & PR VERIFICATION)
# ============================================================================
GITHUB_APP_ID="123456"
GITHUB_APP_SLUG="volt-impact-engine"
GITHUB_APP_CLIENT_ID="Iv1.exampleclientid"
GITHUB_APP_CLIENT_SECRET="your-github-app-client-secret"
GITHUB_APP_PRIVATE_KEY_BASE64="LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQ=="
GITHUB_APP_WEBHOOK_SECRET="whsec_example_github_webhook_secret"
GITHUB_STATE_SIGNING_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ============================================================================
# 6. GOOGLE CLOUD PLATFORM (CLOUD RUN, CLOUD TASKS & CLOUD SCHEDULER)
# ============================================================================
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="asia-south1"
GCP_CLOUD_TASKS_QUEUE="volt-evaluation-queue"
GCP_SERVICE_ACCOUNT_EMAIL="volt-worker@your-gcp-project-id.iam.gserviceaccount.com"
INTERNAL_TASK_SHARED_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ============================================================================
# 7. TELEGRAM BOT (VOICE NOTES & 7:30 PM IST EVENING SWEEPER)
# ============================================================================
TELEGRAM_BOT_TOKEN="123456789:AAFExampleTelegramBotToken"
TELEGRAM_WEBHOOK_SECRET="volt_tg_secret_example_token"
