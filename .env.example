# ============================================================================
# 1. CORE SERVER & ENVIRONMENT
# ============================================================================
NODE_ENV="development"
PORT="8080"
API_PUBLIC_URL="http://localhost:8080"
WEB_PUBLIC_URL="http://localhost:3000"
CANONICAL_TIMEZONE="Asia/Kolkata"

# ============================================================================
# 2. SUPABASE (POSTGRESQL 16 + AUTH + ARTIFACT STORAGE)
# ============================================================================
DATABASE_URL="postgresql://postgres.projectref:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
SUPABASE_URL="https://projectref.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-service-role"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-minimum-32-chars"
SUPABASE_STORAGE_BUCKET="volt-artifacts"

# ============================================================================
# 3. UPSTASH REDIS (SERVERLESS STAGING BUFFER & PBAC CACHE)
# ============================================================================
UPSTASH_REDIS_REST_URL="https://example-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AX-example-upstash-token"

# ============================================================================
# 4. GEMINI 1.5 FLASH (AI JUDGE & MULTIMODAL AUDIO STT)
# ============================================================================
GEMINI_API_KEY="AIzaSyExampleGeminiKey"
GEMINI_MODEL_ID="gemini-1.5-flash"

# ============================================================================
# 5. GITHUB APP INTEGRATION ("CONNECT GITHUB" & PR VERIFICATION)
# ============================================================================
GITHUB_APP_ID="123456"
GITHUB_APP_SLUG="volt-impact-engine"
GITHUB_APP_CLIENT_ID="Iv1.exampleclientid"
GITHUB_APP_CLIENT_SECRET="your-github-app-client-secret"
GITHUB_APP_PRIVATE_KEY_BASE64="LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQ=="
GITHUB_APP_WEBHOOK_SECRET="whsec_example_github_webhook_secret"
GITHUB_STATE_SIGNING_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ============================================================================
# 6. GOOGLE CLOUD PLATFORM (CLOUD RUN, CLOUD TASKS & CLOUD SCHEDULER)
# ============================================================================
