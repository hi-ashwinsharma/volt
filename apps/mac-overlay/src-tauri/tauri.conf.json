{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Volt Overlay",
  "version": "1.0.0",
  "identifier": "build.volt.overlay",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "spotlight",
